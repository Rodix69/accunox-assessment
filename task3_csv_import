import csv
import sqlite3

def import_users(csv_path="users.csv", db_path="users.db"):
    with open(csv_path, newline="", encoding="utf-8") as f:
        rows = [
            (r["name"].strip(), r["email"].strip().lower())
            for r in csv.DictReader(f)
            if r.get("name") and r.get("email")      # skip incomplete rows
        ]

    with sqlite3.connect(db_path) as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                id INTEGER PRIMARY KEY,
                name TEXT NOT NULL,
                email TEXT NOT NULL UNIQUE
            )""")
        before = conn.total_changes
        conn.executemany("INSERT OR IGNORE INTO users (name, email) VALUES (?, ?)", rows)
        print(f"Inserted {conn.total_changes - before} of {len(rows)} rows.")

if __name__ == "__main__":
    import_users()